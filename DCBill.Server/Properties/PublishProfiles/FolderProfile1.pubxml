<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
	<PropertyGroup>
		<DeleteExistingFiles>false</DeleteExistingFiles>
		<ExcludeApp_Data>false</ExcludeApp_Data>
		<LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
		<LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
		<LastUsedPlatform>Any CPU</LastUsedPlatform>
		<PublishProvider>FileSystem</PublishProvider>
		<PublishUrl>\\WIN-SO5DALTE35E\nexbillinvoice</PublishUrl>
		<WebPublishMethod>FileSystem</WebPublishMethod>
		<_TargetId>Folder</_TargetId>
		<SiteUrlToLaunchAfterPublish />
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<ProjectGuid>e64f333d-2d85-c052-1c12-f3fe6208d974</ProjectGuid>
		<SelfContained>false</SelfContained>
	</PropertyGroup>

	<!-- Run React deployment script AFTER .NET Core deployment -->
	<Target Name="DeployReactApp" AfterTargets="Publish">
		<Message Text="========================================" Importance="high" />
		<Message Text="Deploying React Application..." Importance="high" />
		<Message Text="========================================" Importance="high" />

		<Exec Command="powershell.exe -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\dcbill.client\deploy.ps1&quot;" />

		<Message Text="========================================" Importance="high" />
		<Message Text="React Application Deployment Complete!" Importance="high" />
		<Message Text="========================================" Importance="high" />
	</Target>

</Project>